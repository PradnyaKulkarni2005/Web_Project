{
    "version": 2,
    "builds": [
      {
        "src": "Frontend/**/*",
        "use": "@vercel/static"
      },
      {
        "src": "Backend/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/Frontend/$1"
      }
    ]
  }
  